# VoiceHub 核心项目忽略文件
# Python virtual environment
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs and data
logs/
data/
*.log
*.log.*

# Environment and configuration files
.env
.env.*
# 保留示例配置文件
config.yaml
! config.yaml.example

# Docker
docker-compose.override.yml
*.dockerfile

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# 业务测试文件（非项目核心）
*.md
! README.md
! DEPLOYMENT.md
*.png
*.json
*.py
# 核心代码目录全部纳入版本控制
!voicehub/**
!server/**
! requirements.txt
! start.sh
! Dockerfile
! docker-compose.yml

# 临时诊断脚本（voicehub 下，非项目核心资产，按需手动保留）
voicehub/diag_hermes.py
voicehub/verify_gate_apply.py
voicehub/verify_gate_llm.py
voicehub/verify_gate_mining.py
# 一次性日志迁移脚本（硬编码绝对路径、只改 3 个文件日志级别），非项目资产，不入库
voicehub/add_probe_logs.py

# Python 字节码缓存（voicehub 下，因 !voicehub/** 重新纳入，这里再排除）
voicehub/**/__pycache__/
voicehub/**/*.pyc
voicehub/**/*.pyo

# 诊断产物（每通通话的音频/WAV 与转写文本，按需落盘，不入库）
voicehub/server/recordings/
voicehub/server/transcripts/

# 运行时诊断产物：每通通话的麦克风转写文本（由 CallTranscriptRecorder 生成）
# 纯排查用，非项目核心资产，不入库
voicehub/server/transcripts/
