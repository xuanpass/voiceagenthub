# VoiceHub 核心项目忽略文件
# Python virtual environment
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs and data
logs/
data/
*.log
*.log.*

# Environment and configuration files
.env
.env.*
# 保留示例配置文件
config.yaml
! config.yaml.example

# Docker
docker-compose.override.yml
*.dockerfile

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# 业务测试文件（非项目核心）
*.md
! README.md
! DEPLOYMENT.md
*.png
*.json
*.py
# 核心代码目录全部纳入版本控制
!voicehub/**
!server/**
! requirements.txt
! start.sh
! Dockerfile
! docker-compose.yml

# 调试运行目录（voicehub/debug/ 下集中存放调试/运行脚本与旧版运行文件副本，
# 非项目核心资产；git 提交时只提交源码，调试运行代码一律不入库）
voicehub/debug/
# pytest 缓存（.pytest_cache/ 规则被下方 !voicehub/** 重新纳入，此处再排除）
voicehub/.pytest_cache/

# Python 字节码缓存（voicehub 下，因 !voicehub/** 重新纳入，这里再排除）
voicehub/**/__pycache__/
voicehub/**/*.pyc
voicehub/**/*.pyo

# 运行时产物：因 !voicehub/** 重新纳入整个 voicehub 源码树，以下运行时文件
# 在此显式排除（源码 voicehub/server/voiceprint/ 仍纳入版本控制）
voicehub/.env
voicehub/.env.*
voicehub/run.log
voicehub/recordings/
voicehub/server/recordings/
voicehub/transcripts/
voicehub/server/transcripts/
voicehub/voiceprints/

# 本地模型权重与 SSL 私钥，不入库
models/
ssl/
