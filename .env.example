# VoiceHub 后端配置示例
# 复制此文件为 .env 并修改配置

# LLM 后端配置
ACTIVE_LLM_BACKEND=openai
OPENAI_API_BASE=http://localhost:8642/v1/chat/completions
OPENAI_API_KEY=sk-123456
OPENAI_MODEL=gpt-3.5-turbo
OPENCLAW_BIN=~/.local/bin/openclaw

# STT 后端配置
ACTIVE_STT_BACKEND=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS 后端配置
ACTIVE_TTS_BACKEND=edge
TTS_VOICE_HERMES=zh-CN-YunxiNeural
TTS_VOICE_CHERRY=zh-CN-XiaoxiaoNeural
TTS_VOICE_OPENCLAW=zh-CN-YunyangNeural

# 服务器配置
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=info