# VoiceHub 后端配置示例
# 复制此文件为 .env 并修改配置

# LLM 后端配置
ACTIVE_LLM_BACKEND=openai
OPENAI_API_BASE=http://localhost:8642/v1/chat/completions
OPENAI_API_KEY=sk-123456
OPENAI_MODEL=gpt-3.5-turbo
OPENCLAW_BIN=~/.local/bin/openclaw

# STT 后端配置 (优先级: env > agents.yaml stt 段 > 代码默认值)
ACTIVE_STT_BACKEND=whisper        # whisper | sensevoice; 部署机 .101 用 sensevoice 根治静音幻觉
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# sensevoice 专用: 模型目录 (INT8 ONNX); 不设则用 agents.yaml stt.model_dir
SENSEVOICE_MODEL_DIR=

# TTS 后端配置 (env TTS_VOICE_<AGENT名大写> 覆盖 agents.yaml 对应 agent 的 tts_voice)
ACTIVE_TTS_BACKEND=edge
TTS_VOICE_HERMES=zh-CN-YunxiNeural
TTS_VOICE_CHERRYSTUDIO=zh-CN-XiaoxiaoNeural
TTS_VOICE_OPENCLAW=zh-CN-YunyangNeural
# 兼容旧键: 老部署的 TTS_VOICE_CHERRY 仍映射到 cherrystudio

# 服务器配置
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=info