# 复制为 .env 并填写。VoiceHub 在 .101 运行时读取这些变量。
# 注意: 此文件含密钥, 不要提交进仓库。

# OpenClaw Gateway (192.168.123.101:18789) 的 auth token
# 取自 .101: cat ~/.openclaw/openclaw.json | grep token
OPENCLAW_TOKEN=

# Hermes OpenAI Bridge 端口与密钥 (在 .101 上运行 Hermes 后暴露)
HERMES_PORT=8000
HERMES_KEY=

# CherryStudio API 网关密钥 (.109 上已开启, 设置里可见)
CHERRY_KEY=cs-sk-xxxxxxxx

# WorkBuddy 桥接密钥 (桥接实现后填)
WORKBUDDY_KEY=
