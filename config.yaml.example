# VoiceHub 配置示例
# 复制此文件为 config.yaml 并修改配置

server:
  host: 0.0.0.0
  port: 8765
  max_history: 24
  default_room: default
  ssl:
    key: null
    cert: null

# 支持的LLM后端配置
llm_backends:
  openai:
    endpoint: http://localhost:8642/v1/chat/completions
    api_key: sk-123456
    model: gpt-3.5-turbo
  openclaw:
    bin_path: ~/.local/bin/openclaw

# 活跃的LLM后端
active_llm_backend: openai

# STT配置
stt:
  model: small
  device: cpu
  compute_type: int8

# TTS配置
tts:
  active_backend: edge
  voices:
    hermes: zh-CN-YunxiNeural
    cherry: zh-CN-XiaoxiaoNeural
    openclaw: zh-CN-YunyangNeural

# 智能体配置
agents:
  hermes:
    enabled: true
    tts_voice: zh-CN-YunxiNeural
    session_prefix: hermes_
  cherry:
    enabled: true
    tts_voice: zh-CN-XiaoxiaoNeural
    session_prefix: cherry_
  openclaw:
    enabled: true
    tts_voice: zh-CN-YunyangNeural
    session_prefix: openclaw_

# 路由配置
router:
  default: hermes
  trigger_words:
    - hermes
    - cherry
    - openclaw
  collab_trigger_words:
    - handoff
    - review
    - roundtable
  collab_modes:
    handoff: sequential
    review: two_stage
    roundtable: parallel